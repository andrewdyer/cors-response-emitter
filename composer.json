{
  "name": "andrewdyer/cors-response-emitter",
  "description": "A CORS-aware response emitter for Slim Framework applications that applies consistent CORS and cache-control headers",
  "keywords": ["php", "slim", "cors", "http", "psr-7", "middleware"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Dyer",
      "homepage": "https://andrewdyer.rocks",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/andrewdyer/cors-response-emitter",
  "support": {
    "issues": "https://github.com/andrewdyer/cors-response-emitter/issues",
    "source": "https://github.com/andrewdyer/cors-response-emitter"
  },
  "autoload": {
    "psr-4": {
      "AndrewDyer\\CorsResponseEmitter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewDyer\\CorsResponseEmitter\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.12"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
